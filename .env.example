
TELEGRAM_BOT_TOKEN=
TWELVE_DATA_API_KEY=
TELEGRAM_CHANNEL_ID=

DEFAULT_TIMEFRAME=5m
MONITOR_INTERVAL_MINUTES=15
TWELVE_DATA_DAILY_CREDIT_LIMIT=800
MIN_REQUEST_INTERVAL_SECONDS=7.6
# Optional override for the default official BLS calendar feed.
# Use only an HTTPS feed whose terms permit the intended use.
ECONOMIC_CALENDAR_ICS_URL=

# Optional global consensus/news provider. Only enable with a contract that permits
# displaying/redistributing provider data to your Telegram bot users (e.g. Enterprise).
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_DISTRIBUTION_LICENSED=false

# Optional Telegram user ID allowed to manually edit shared official events.
BOT_OWNER_ID=

# Optional AI macro/news interpretation. API billing is separate from ChatGPT.
# Add a valid OpenAI API key only after choosing your own API budget.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ECONOMIC_INTELLIGENCE_ENABLED=true
AI_ECONOMIC_INTELLIGENCE_DAILY_CALL_LIMIT=16
